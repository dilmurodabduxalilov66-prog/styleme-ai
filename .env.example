# StyleMe AI - Public Environment Variables Template
# Copy this file to .env and fill in your real credentials.

# Application & Node Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/styleme_db?schema=public

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/styleme_portfolio

# Redis Connection
REDIS_URL=redis://localhost:6379

# Apache Kafka Brokers
KAFKA_BROKERS=localhost:9092

# JWT Security Secrets (Use long random strings in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# AI & Machine Learning Services
AI_SERVICE_URL=http://localhost:8000
GPU_WORKER_CONCURRENCY=2
REPLICATE_API_TOKEN=r8_your_replicate_api_token_here
HF_TOKEN=hf_your_huggingface_token_here

# Cloudflare R2 Object Storage
R2_BUCKET_NAME=styleme-assets
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Eskiz SMS API Gateway (Uzbekistan SMS OTP)
ESKIZ_EMAIL=your_eskiz_email@example.com
ESKIZ_PASSWORD=your_eskiz_password_here

# Payment Gateway Integrations
CLICK_SERVICE_ID=your_click_service_id
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SECRET_KEY=your_click_secret_key

PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_SECRET_KEY=your_payme_secret_key

# Twilio SMS API Gateway (Optional)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
