# StyleMe AI - Production Environment Variables

# ================= Database =================
DATABASE_URL=postgresql://styleme_user:styleme_password@postgres:5432/styleme_db
REDIS_URL=redis://redis:6379
MONGO_URI=mongodb://mongodb:27017/styleme_logs

# ================= Security =================
JWT_ACCESS_SECRET=your_secure_access_secret_here
JWT_REFRESH_SECRET=your_secure_refresh_secret_here
SENTRY_DSN=https://your_sentry_dsn_here

# ================= 3rd Party APIs =================
ESKIZ_EMAIL=your_eskiz_email
ESKIZ_PASSWORD=your_eskiz_password
CLICK_SECRET_KEY=your_click_secret
PAYME_SECRET_KEY=your_payme_secret
REPLICATE_API_TOKEN=your_replicate_token

# ================= AI & ML =================
HF_TOKEN=your_huggingface_token
R2_ACCESS_KEY_ID=your_cloudflare_r2_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret
R2_BUCKET_NAME=styleme-assets
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# ================= App =================
NODE_ENV=production
PORT=9001
